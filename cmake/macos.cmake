        --spirv-val ${BLUR_SPIRV_VAL} --clang ${BLUR_SHADER_CLANG})
    set(_mac_shader_cpp)
    foreach(_shader_target IN LISTS BLUR_MAC_SHADER_TARGETS)
        list(APPEND _mac_shader_cpp "${CMAKE_CURRENT_BINARY_DIR}/authored-shaders/${_shader_target}_metal_shaders.cpp")
    endforeach()
    add_custom_target(blur_mac_authored_shaders
        COMMAND ${Python3_EXECUTABLE} ${BLUR_TOP}/tools/macos/compile_shaders.py
            --manifest ${CMAKE_CURRENT_BINARY_DIR}/generated/targets_pc_speed.json
            --top ${BLUR_TOP} --out ${CMAKE_CURRENT_BINARY_DIR}/authored-shaders ${_mac_shader_compiler_args}
        COMMAND $<TARGET_FILE:blur_mac_check_shaders> ${CMAKE_CURRENT_BINARY_DIR}/authored-shaders/report.json
        BYPRODUCTS ${_mac_shader_cpp}
        DEPENDS blur_mac_check_shaders USES_TERMINAL VERBATIM)
    set_source_files_properties(${_mac_shader_cpp} PROPERTIES GENERATED TRUE)
    add_library(blur_mac_builtin_shaders STATIC EXCLUDE_FROM_ALL ${_mac_shader_cpp})
