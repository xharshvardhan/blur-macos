# Actual resource/mount/schema modules from Jam, sharing native engine services.
# [Blur2PC] Native DW configuration is included by game-facing public headers.
find_path(BLUR_NATIVE_TOMCRYPT_INCLUDE tomcrypt.h HINTS /opt/homebrew/opt/libtomcrypt/include /opt/homebrew/include /usr/local/include REQUIRED)
target_include_directories(blur_mac_engine_system BEFORE PUBLIC ${BLUR_NATIVE_TOMCRYPT_INCLUDE})
find_path(BLUR_NATIVE_TOMMATH_INCLUDE tommath.h HINTS /opt/homebrew/opt/libtommath/include /opt/homebrew/include /usr/local/include REQUIRED)
foreach(_module xtgame logicalfs resource framework input display camera2 render world_render renderingdata scenegraph fx misc_shared animation air portal shader textureresource game_resource gravity racingphysics dynamic crowd_system effect actor_system animated_model game_context lod resource_utils ui liblua lua_shared lua_helper deferred amax amax_ui amax_gamelogic amax_network network amax_audio amax_racebook amax_kanzen movie navmesh vehicle debugsystems game_debug game_physics gameview helper_screens shared_actors specialfx blobshadows dropshadows auxflares lighttrails splashcamera actor_studio_msg_game actor_studio_msg_shared jpeghelper security advertising)
    string(TOUPPER "${_module}" _module_upper)
    add_library(blur_mac_${_module} STATIC ${BLUR_MAC_${_module_upper}_SOURCES})
    # Module PCH must precede transitive headers (UI Jam also includes Amax/game).
    target_include_directories(blur_mac_${_module} BEFORE PRIVATE ${BLUR_MAC_${_module_upper}_ROOT})
    target_include_directories(blur_mac_${_module} PUBLIC ${BLUR_MAC_${_module_upper}_INCLUDE_DIRS})
    target_include_directories(blur_mac_${_module} BEFORE PUBLIC ${BLUR_NATIVE_TOMCRYPT_INCLUDE} ${BLUR_NATIVE_TOMMATH_INCLUDE})
    target_compile_definitions(blur_mac_${_module} PRIVATE ${BLUR_MAC_${_module_upper}_DEFINES})
    target_link_libraries(blur_mac_${_module} PUBLIC blur_mac_engine_system)
endforeach()
